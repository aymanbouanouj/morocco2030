# Local development defaults only. Create a unique APP_KEY in your own .env.
APP_NAME="Morocco2030"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# Use HTTPS and production-specific credentials. Never commit the generated .env.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
TOURNAMENT_TIMEZONE=Africa/Casablanca
TOURNAMENT_COUNTDOWN_TITLE="Tournament Countdown"
TOURNAMENT_COUNTDOWN_LABEL="Opening Match"
TOURNAMENT_COUNTDOWN_TARGET="2030-06-08 20:00:00"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Example local MySQL or MariaDB connection. Supply your own credentials in .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=morocco2030_local
DB_USERNAME=morocco2030_local
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB
# DB_SOCKET=
# DB_URL=

# Requires sessions table (created by migrations).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Requires jobs, job_batches, and failed_jobs tables (created by migrations).
QUEUE_CONNECTION=database

# Requires cache and cache_locks tables (created by migrations).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional football-data.org integration. Obtain and store your own token in .env.
EXTERNAL_FOOTBALL_PROVIDER=football-data
EXTERNAL_FOOTBALL_BASE_URL=https://api.football-data.org/v4
EXTERNAL_FOOTBALL_API_TOKEN=
EXTERNAL_FOOTBALL_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
